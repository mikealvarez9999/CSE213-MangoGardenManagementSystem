<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="568.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cse213.cse213mangogardenmanagementsystem.GeneralManager.controller.CalculateWorkerSalaryController">
   <children>
       <Label layoutX="20.0" layoutY="20.0" text="CALCULATE WORKER SALARY">
           <font>
               <Font name="System Bold" size="20.0" />
           </font>
       </Label>
       <Label layoutX="20.0" layoutY="50.0" prefWidth="660.0" text="Calculate payable salary for each worker" wrapText="true" />
      <TextField fx:id="workerIDTF" layoutX="134.0" layoutY="98.0" />
      <Label layoutX="32.0" layoutY="102.0" text="Enter Worker ID:" />
      <Label fx:id="workerFoundLabel" layoutX="32.0" layoutY="144.0" prefHeight="67.0" prefWidth="599.0" text="Found: Worker-99" />
      <Label layoutX="50.0" layoutY="230.0" text="Enter month:" />
      <ComboBox fx:id="monthCB" layoutX="134.0" layoutY="226.0" prefWidth="150.0" />
      <TextField fx:id="presentDaysTF" layoutX="134.0" layoutY="291.0" onAction="#reCalculate" />
      <Label layoutX="49.0" layoutY="295.0" text="Days Present:" />
      <TextField fx:id="taxTF" layoutX="434.0" layoutY="291.0" onAction="#reCalculate" />
      <Label layoutX="335.0" layoutY="295.0" text="Tax Percentage:" />
      <TextField fx:id="grossPayTF" layoutX="134.0" layoutY="336.0" onAction="#reCalculate" />
      <Label layoutX="65.0" layoutY="340.0" text="Gross Pay:" />
      <TextField fx:id="advancesTF" layoutX="434.0" layoutY="336.0" onAction="#reCalculate" />
      <Label layoutX="366.0" layoutY="340.0" text="Advances:" />
      <TextField fx:id="netPayTF" editable="false" layoutX="306.0" layoutY="439.0" />
      <Label layoutX="245.0" layoutY="443.0" text="Net Pay:" />
      <Button layoutX="281.0" layoutY="392.0" mnemonicParsing="false" onAction="#calculateButtonOA" text="Calculate Net Pay" />
      <Button layoutX="291.0" layoutY="481.0" mnemonicParsing="false" onAction="#saveButtonOA" text="Save Record" />
      <Label fx:id="successLabel" alignment="CENTER" layoutX="31.0" layoutY="525.0" prefHeight="21.0" prefWidth="619.0" text="Record of OMUK saved successfully!" textFill="#009e03">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Label>
      <Button layoutX="315.0" layoutY="98.0" mnemonicParsing="false" onAction="#searchWorkerButtonOA" text="Search for Worker" />
   </children>
</AnchorPane>
