<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="428.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cse213.cse213mangogardenmanagementsystem.GeneralManager.controller.CheckInventoryController">
   <children>
       <Label layoutX="20.0" layoutY="20.0" text="CHECK INVENTORY STATUS">
           <font>
               <Font name="System Bold" size="20.0" />
           </font>
       </Label>
       <Label layoutX="20.0" layoutY="50.0" prefWidth="660.0" text="View the inventory status. Refresh to fetch new data." wrapText="true" />

       <TableView fx:id="inventoryTV" layoutX="52.0" layoutY="94.0" prefHeight="263.0" prefWidth="497.0">
        <columns>
          <TableColumn fx:id="batchidTC" prefWidth="171.0" text="Batch ID" />
          <TableColumn fx:id="quantityTC" prefWidth="146.0" text="Quantity" />
            <TableColumn fx:id="spoilageTC" prefWidth="179.0" text="Spoilage" />
        </columns>
      </TableView>
      <Button layoutX="262.0" layoutY="371.0" mnemonicParsing="false" onAction="#refreshButtonOnAction" prefHeight="23.0" prefWidth="78.0" text="Refresh">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
