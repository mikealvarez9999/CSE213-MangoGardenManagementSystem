<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cse213.cse213mangogardenmanagementsystem.GeneralManager.controller.GenerateTaskReportController">
    <children>

        <Label layoutX="20.0" layoutY="20.0" text="GENERATE PERIODICAL TASK REPORT">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Label layoutX="20.0" layoutY="50.0" prefWidth="660.0" text="Select the start and end time, and click Generate." wrapText="true" />

        <Label layoutX="20.0" layoutY="85.0" text="Report Parameters" />

        <Button layoutX="452.0" layoutY="110.0" onAction="#generateButtonOA" text="Generate Weekly Report" />

        <Label layoutX="20.0" layoutY="160.0" text="Weekly report:" />
        <TextArea fx:id="reportTA" editable="false" layoutX="20.0" layoutY="185.0" prefHeight="389.0" prefWidth="660.0" />
      <DatePicker fx:id="startDP" layoutX="20.0" layoutY="110.0" promptText="Start Date" />
      <DatePicker fx:id="endDP" layoutX="227.0" layoutY="110.0" promptText="End Date" />
    </children>
</AnchorPane>
