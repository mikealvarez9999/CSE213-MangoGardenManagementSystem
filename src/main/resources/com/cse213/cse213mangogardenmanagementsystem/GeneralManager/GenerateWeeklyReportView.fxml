<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cse213.cse213mangogardenmanagementsystem.GeneralManager.controller.GenerateWeeklyReportController">
    <children>

        <Label layoutX="20.0" layoutY="20.0" text="GENERATE WEEKLY TASK REPORT">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>
        <Label layoutX="20.0" layoutY="50.0" prefWidth="660.0" text="Select the week and click Generate." wrapText="true" />

        <Label layoutX="20.0" layoutY="85.0" text="Report Parameters" />
        <ComboBox fx:id="cmbStatementType" layoutX="20.0" layoutY="110.0" prefWidth="250.0" promptText="Select Week" />

        <Button layoutX="296.0" layoutY="110.0" onAction="#handleGeneratePreview" text="Generate Preview" />

        <Label layoutX="20.0" layoutY="160.0" text="Weekly report:" />
        <TextArea fx:id="txtPreview" editable="false" layoutX="20.0" layoutY="185.0" prefHeight="350.0" prefWidth="660.0" />

        <Button disable="true" layoutX="540.0" layoutY="550.0" onAction="#handleExportStatement" text="Export to PDF/Excel" />
    </children>
</AnchorPane>
