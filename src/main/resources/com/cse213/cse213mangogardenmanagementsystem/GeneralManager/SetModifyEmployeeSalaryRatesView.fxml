<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="456.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cse213.cse213mangogardenmanagementsystem.GeneralManager.controller.SetModifyEmployeeSalaryRatesController">
   <children>
       <Label layoutX="20.0" layoutY="20.0" text="SET/MODIFY EMPLOYEE SALARY RATES">
           <font>
               <Font name="System Bold" size="20.0" />
           </font>
       </Label>
       <Label layoutX="20.0" layoutY="50.0" prefHeight="17.0" prefWidth="487.0" text="View the current employee salary rates, modify if needed." wrapText="true" />

       <TableView fx:id="salaryRatesTV" layoutX="19.0" layoutY="85.0" prefHeight="200.0" prefWidth="487.0">
        <columns>
          <TableColumn fx:id="employeeTypeTC" prefWidth="147.0" text="Employee Type" />
          <TableColumn fx:id="intervalTC" minWidth="0.0" prefWidth="125.0" text="Salary Interval" />
            <TableColumn fx:id="rateTC" minWidth="0.0" prefWidth="145.0" text="Salary Rate" />
        </columns>
      </TableView>
      <Label layoutX="54.0" layoutY="308.0" text="Select Employee Type:" />
      <Label layoutX="60.0" layoutY="336.0" text="Select Salary Interval:" />
      <Label layoutX="91.0" layoutY="364.0" text="Set Salary Rate:" />
      <TextField fx:id="setRateTF" layoutX="192.0" layoutY="360.0" />
      <ComboBox fx:id="selectTypeCB" layoutX="192.0" layoutY="304.0" prefWidth="150.0" />
      <ComboBox fx:id="selectIntervalCB" layoutX="192.0" layoutY="332.0" prefWidth="150.0" />
      <Button layoutX="376.0" layoutY="332.0" mnemonicParsing="false" onAction="#applyButtonOA" text="Apply Changes" />
      <Label fx:id="successLabel" alignment="CENTER" layoutX="20.0" layoutY="406.0" prefHeight="17.0" prefWidth="516.0" textFill="#16bc00">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
