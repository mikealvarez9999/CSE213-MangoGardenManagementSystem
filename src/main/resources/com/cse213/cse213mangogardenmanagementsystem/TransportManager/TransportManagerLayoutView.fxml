<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #fefefe;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cse213.cse213mangogardenmanagementsystem.TransportManager.controller.TransportManagerController">

    <!-- TOP HEADER -->
    <top>
        <VBox alignment="CENTER_LEFT" style="-fx-background-color: #1E4E43; -fx-padding: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 5);" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="welcomeLabel" text="MANGO GARDEN - Transport Manager" textFill="#fefefe">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="240.0" spacing="15.0" style="-fx-background-color: #1e4e43; -fx-padding: 20px;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-padding: 0 0 10 0; -fx-text-fill: #F0F347;" text="DASHBOARD" />

                <Button maxWidth="Infinity" onAction="#assignVehiclesOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="assignVehicles" />
                <Button maxWidth="Infinity" onAction="#trackDeliveriesOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="trackDeliveries" />
                <Button maxWidth="Infinity" onAction="#recordDeliveryCompletedOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="RecordDeliveryCompleted" />
                <Button maxWidth="Infinity" onAction="#scheduleMaintenanceOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="scheduleMaintenance" />
                <Button maxWidth="Infinity" onAction="#assignDriversOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="AssignDrivers" />
                <Button maxWidth="Infinity" onAction="#requestVehicleServicingBudgetOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="RequestVehicleServicingBudget" />
                <Button maxWidth="Infinity" onAction="#ViewDeliveryLogsOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="View Delivery Logs" />
                <Button maxWidth="Infinity" onAction="#deliverySummaryOnMouseClick" style="-fx-background-color: #E08854; -fx-text-fill: #1E4E43; -fx-font-weight: bold; -fx-padding: 10px; -fx-background-radius: 8px; -fx-cursor: hand;" text="Delivery Summary" />
            </children>
            <BorderPane.margin>
                <Insets right="5.0" />
            </BorderPane.margin>
        </VBox>
    </left>

    <!-- CENTER CONTENT AREA -->
    <center>
        <VBox fx:id="contentContainer" prefHeight="600.0" prefWidth="600.0" style="-fx-padding: 10;" />
    </center>

</BorderPane>
